{
  "name": "pescuit-premium",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=packages/engine",
    "sim": "npm run sim --workspace=packages/engine",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client"
  },
  "engines": {
    "node": ">=18"
  }
}
